{
  "name": "spl3_roulette_bot",
  "version": "1.0.0",
  "description": "Splatoon 3 weapon roulette Discord Bot",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "data:update": "node scripts/update-weapons.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kai20020918/spl3_roulette_bot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kai20020918/spl3_roulette_bot/issues"
  },
  "homepage": "https://github.com/kai20020918/spl3_roulette_bot#readme",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
